# Poloniex API credentials.
# Required only for the authenticated `get_balances` tool. A read-only key is
# recommended since this server never places trades.
POLONIEX_API_KEY=
POLONIEX_API_SECRET=

# Optional overrides (defaults shown).
# POLONIEX_BASE_URL=https://api.poloniex.com
# POLONIEX_TIMEOUT_MS=10000
